{
  "name": "gasti-wallet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:web && tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply wallet-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wallet-db --remote",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "wrangler": "^4.16.0"
  }
}

# Clave de Google AI Studio (Gemini)
GEMINI_API_KEY=""

# Token del bot de Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=""

# Secretos OBLIGATORIOS en v3.1 (autenticación fail-closed; sin defaults inseguros)
